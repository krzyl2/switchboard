      "ReconnectMinDelay": "00:00:01",
      "ReconnectMaxDelay": "00:01:00",
      "KeepAlivePeriod": "00:00:15",
      "ShutdownTimeout": "00:00:03"
    },
    "Heartbeat": {
      "Interval": "00:00:10",
