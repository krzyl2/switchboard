      "ReconnectMinDelay": "00:00:01",
      "ReconnectMaxDelay": "00:01:00",
      "StateReadTimeout": "00:00:05"
    },
    "Mqtt": {
      "SupervisorServiceUrl": "http://supervisor/services/mqtt",
      "DiscoveryPrefix": "homeassistant",
