{
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Switchboard": {
    "Ingress": {
      "Port": 8099,
      "TrustedProxy": "172.30.32.2"
    },
    "HomeAssistant": {
      "SupervisorWebSocketUrl": "ws://supervisor/core/websocket",
      "PingInterval": "00:00:30",
      "PongTimeout": "00:00:10",
      "ReconnectMinDelay": "00:00:01",
      "ReconnectMaxDelay": "00:01:00"
    },
    "Mqtt": {
      "SupervisorServiceUrl": "http://supervisor/services/mqtt",
      "DiscoveryPrefix": "homeassistant",
      "BaseTopic": "switchboard",
      "ClientId": "switchboard",
      "ReconnectMinDelay": "00:00:01",
      "ReconnectMaxDelay": "00:01:00",
      "KeepAlivePeriod": "00:00:15",
      "ShutdownTimeout": "00:00:04"
    },
    "Heartbeat": {
      "Interval": "00:00:10",
      "ExpireAfter": "00:00:30"
    }
  }
}
